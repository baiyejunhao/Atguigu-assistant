# =========================================================
# Atguigu 客服知识库 —— 环境变量示例
# 使用方法：复制本文件为 .env，并填入你自己的真实值
#   cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，请勿提交真实密钥
# =========================================================

# ---------- 嵌入模型（BAAI/bge-large-en-v1.5，经 SiliconFlow）----------
SILICONFLOW_API_KEY=your-siliconflow-api-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ---------- 生成模型（deepseek-v4-flash）----------
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---------- 可选：其他模型供应商（非本案例必需）----------
ZHIPUAI_API_KEY=your-zhipuai-api-key
ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
DASHSCOPE_API_KEY=your-dashscope-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
CLOSEAI_API_KEY=your-closeai-api-key
CLOSEAI_API_BASE=https://your-closeai-endpoint/v1

# ---------- 可选：LangSmith 链路追踪 ----------
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=atguigu-rag

# ---------- 可选：Tavily 搜索 / MinerU 文档解析 ----------
TAVILY_API_KEY=your-tavily-api-key
MINERU_API_TOKEN=your-mineru-token
